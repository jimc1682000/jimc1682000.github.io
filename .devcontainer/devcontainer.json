{
  "name": "jimc personal site",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/site,type=bind",
  "workspaceFolder": "/workspaces/site",
  "containerUser": "${localEnv:SITE_CONTAINER_USER:node}",
  "remoteUser": "${localEnv:SITE_CONTAINER_USER:node}",
  "updateRemoteUserUID": true,
  "init": true,
  "mounts": [
    "source=site-node-modules-${devcontainerId},target=/workspaces/site/node_modules,type=volume",
    "source=site-npm-cache-${devcontainerId},target=/home/node/.npm,type=volume"
  ],
  "runArgs": ["--publish=127.0.0.1::4321"],
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro development server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "site-post-create",
  "waitFor": "postCreateCommand",
  "shutdownAction": "stopContainer"
}
