{
  "name": "jimc-personal-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run sync:webmentions && astro build",
    "postbuild": "pagefind --site dist && node scripts/check-fonts.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "validate:mf2": "node scripts/validate-microformats.mjs",
    "validate": "npm run check && npm run lint && npm run lint:css && npm run lint:md && npm run format:check && npm run test:webmentions && npm run build && npm run validate:mf2 && npm run lint:html",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:md": "markdownlint-cli2",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "lint:deps": "knip",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:og": "node scripts/build-og.mjs",
    "sync:webmentions": "node scripts/sync-webmentions.mjs",
    "test:webmentions": "node --test scripts/webmention-utils.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "entities": "^8.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.17.0",
    "knip": "^6.43.0",
    "markdownlint-cli2": "^0.24.0",
    "microformats-parser": "^2.0.6",
    "pagefind": "^1.4.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
