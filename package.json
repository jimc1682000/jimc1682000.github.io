{
  "name": "jimc-personal-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "validate:mf2": "node scripts/validate-microformats.mjs",
