{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "no-inline-style": "off",
    "long-title": "off",
    "wcag/h30": "off",
    "valid-id": [
      "error",
      {
        "relaxed": true
      }
    ]
  }
}
