---
// Webmention 顯示（P2-11）：sync-webmentions.mjs 先在 build 前抓取、moderate、
// 本地化 avatar；元件只讀 private build cache，不讓 visitor 連線到 author.photo 主機。
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  /** 本頁的絕對 URL（h-entry 的 u-url，同時是 webmention 的 target） */
  target: URL;
  lang: Lang;
}

interface Mention {
  id: string;
  property: string;
  source: string;
  published?: string | null;
  author?: { name?: string; photo?: string; url?: string };
  text?: string;
}

const { target, lang } = Astro.props;
const t = useTranslations(lang);

let mentions: Mention[] = [];
const cacheFile = resolve(process.cwd(), '.cache/webmentions/data.json');
if (existsSync(cacheFile)) {
  const data = JSON.parse(readFileSync(cacheFile, 'utf8'));
  const path = target.pathname.endsWith('/') ? target.pathname : `${target.pathname}/`;
  if (Array.isArray(data?.mentionsByPath?.[path])) mentions = data.mentionsByPath[path];
}

const isLike = (m: Mention) => m.property === 'like-of';
const isRepost = (m: Mention) => m.property === 'repost-of';

const likes = mentions.filter(isLike);
const reposts = mentions.filter(isRepost);
const replies = mentions.filter((m) => m.property === 'in-reply-to' && Boolean(m.text));

const show = likes.length > 0 || reposts.length > 0 || replies.length > 0;
---

{
  show && (
    <section class="wm" aria-label={t('webmention.title')}>
      <h2 class="wm-h">{t('webmention.title')}</h2>

      {(likes.length > 0 || reposts.length > 0) && (
        <div class="faces">
          {[...reposts, ...likes].map((m) => (
            <a
              class="face"
              href={m.author?.url || m.source}
              target="_blank"
              rel="noopener noreferrer nofollow"
              title={`${m.author?.name ?? ''}${isRepost(m) ? ` · ${t('webmention.reposts')}` : ''}`}
            >
              {m.author?.photo ? (
                <img
                  src={m.author.photo}
                  alt={m.author?.name ?? ''}
                  loading="lazy"
                  width="32"
                  height="32"
                />
              ) : (
                <span class="noface">{(m.author?.name ?? '?').slice(0, 1)}</span>
              )}
            </a>
          ))}
          <span class="count">
            {likes.length > 0 && `${likes.length} ${t('webmention.likes')}`}
            {likes.length > 0 && reposts.length > 0 && ' · '}
            {reposts.length > 0 && `${reposts.length} ${t('webmention.reposts')}`}
          </span>
        </div>
      )}

      {replies.length > 0 && (
        <ul class="replies">
          {replies.map((m) => (
            <li class="reply">
              <a
                class="who"
                href={m.author?.url || m.source}
                target="_blank"
                rel="noopener noreferrer nofollow"
              >
                {m.author?.name ?? t('webmention.someone')}
              </a>
              {/* 只取純文字：外站內容不注入 HTML。 */}
              <p class="what">{m.text}</p>
              {m.source && (
                <a class="src" href={m.source} target="_blank" rel="noopener noreferrer nofollow">
                  {t('webmention.source')} →
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .wm {
    margin-top: var(--spacing-md);
  }

  .wm-h {
    font-size: var(--text-lede);
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .faces {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--spacing-lg);
  }

  .face img,
  .noface {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    object-fit: cover;
    background: var(--color-bg-surface);
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
  }

  .count {
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    margin-left: 4px;
  }

  .replies {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .reply {
    padding-left: var(--spacing-md);
    border-left: 3px solid var(--color-border-subtle);
  }

  .who {
    color: var(--color-text);
    font-size: var(--text-label);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-seal);
  }

  .what {
    margin: 6px 0 4px;
    font-size: var(--text-ui);
    color: var(--color-text-secondary);
    white-space: pre-wrap;
  }

  .src {
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    text-decoration: none;
  }

  .src:hover {
    color: var(--color-seal);
  }
</style>
