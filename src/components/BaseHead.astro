---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { cfBeaconToken, webmentionDomain, webmentionEnabled } from '../consts';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 文章頁傳入這兩個 → og:type 改 article、並輸出 BlogPosting 結構化資料 */
  pubDate?: Date;
  tags?: string[];
}

const { title, description, lang, pubDate, tags } = Astro.props;
const isArticle = Boolean(pubDate);

// canonical：以 site 為基準的絕對 URL（DESIGN §9）
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// RSS：繁中 /rss.xml、英文 /en/rss.xml（A1 路由）
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
const rssTitle = lang === 'en' ? 'Jimmy Chen — Blog (EN)' : 'Jimmy Chen — Blog';

// hreflang：zh↔en 路徑對換（A1）。tag/search 頁跳過（各語系 tag 名不對稱，
// 對換路徑可能不存在）。x-default 指繁中。
const p = Astro.url.pathname;
const isEn = p === '/en' || p.startsWith('/en/');
const zhPath = isEn ? p.slice(3) || '/' : p;
const enPath = isEn ? p : p === '/' ? '/en/' : '/en' + p;
const skipHreflang = p.includes('/tags/') || /\/search\/?$/.test(p);
---

{/* no-flash theme：務必放 <head> 最前，於任何樣式套用前設定 data-theme（DESIGN §6） */}
<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      var theme =
        stored ||
        (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{
  !skipHreflang && (
    <>
      <link rel="alternate" hreflang="zh-Hant" href={new URL(zhPath, Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(zhPath, Astro.site)} />
    </>
  )
}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={rssTitle} href={rssHref} />

{/* IndieAuth / Web Sign-In（P2-13）：讓「用 jimmychen.me 登入第三方服務」被更多服務認得。
    委派給 indieauth.com —— 靜態站沒有後端可自行簽發，這是 IndieWeb 社群的標準做法
    （tantek.com、adactio.com 皆如此委派）。身分驗證仍是靠首頁的 rel="me"。
    刻意不宣告 token_endpoint：那是給 Micropub 發 token 用的，本站沒有 Micropub，
    宣告了也沒有用途；日後真要加 Micropub 時再一起補。 */}
<link rel="authorization_endpoint" href="https://indieauth.com/auth" />

{/* Webmention endpoint（P2-11）：webmention.io 代收。未設 domain 則不輸出。
    刻意不輸出 rel="pingback"：pingback 是 XML-RPC 舊協定、垃圾訊息重災區，
    已在 webmention.io 停用；宣告一個停用的端點只會引來嘗試。 */}
{
  webmentionEnabled && (
    <link rel="webmention" href={`https://webmention.io/${webmentionDomain}/webmention`} />
  )
}

{/* Open Graph。og:image 用站台通用卡（見 public/og.svg 的說明：CI 無中文字型，
    故不做每篇動態生成；每篇差異由 og:title / og:description 表達）。
    絕對 URL 是必要的 —— 各平台的爬蟲不會解析相對路徑。 */}
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="吉光聚斂，米粒成章" />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />
<meta property="og:image" content={new URL('/og.png', Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="吉光聚斂，米粒成章 — 陳建豪 Jimmy Chen" />
{isArticle && <meta property="article:published_time" content={pubDate!.toISOString()} />}
{isArticle && tags?.map((tag) => <meta property="article:tag" content={tag} />)}
{/* summary_large_image：有 1200×630 的圖才值得用大圖卡 */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL('/og.png', Astro.site)} />

{/* JSON-LD 結構化資料：文章頁 BlogPosting、其餘頁 Person（首頁的 h-card 已有 mf2，
    這裡是給搜尋引擎的另一套表述，兩者並存不衝突）。 */}
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(
    isArticle
      ? {
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: title,
          description,
          datePublished: pubDate!.toISOString(),
          keywords: tags,
          inLanguage: lang === 'en' ? 'en' : 'zh-Hant',
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
          image: new URL('/og.png', Astro.site).href,
          author: {
            '@type': 'Person',
            name: lang === 'en' ? 'Jimmy Chen' : '陳建豪',
            url: new URL('/', Astro.site).href,
          },
        }
      : {
          '@context': 'https://schema.org',
          '@type': 'Person',
          name: lang === 'en' ? 'Jimmy Chen' : '陳建豪',
          alternateName: lang === 'en' ? '陳建豪' : 'Jimmy Chen',
          jobTitle: 'AI Engineer · DevOps / SRE',
          url: new URL('/', Astro.site).href,
          image: new URL('/avatar.png', Astro.site).href,
          email: 'mailto:hi@jimmychen.me',
          sameAs: [
            'https://github.com/jimc1682000',
            'https://www.linkedin.com/in/594jimmychen',
            'https://bsky.app/profile/jimmychen.me',
          ],
        },
  )}
/>

{/* Cloudflare Web Analytics(P2-10,無 cookie、隱私友善)。token 為空則不輸出(gating)。 */}
{
  cfBeaconToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
    />
  )
}
