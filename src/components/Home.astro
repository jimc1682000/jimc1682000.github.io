---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getPosts, slugOf, formatYearMonth } from '../lib/blog';
import Seal from './Seal.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sub =
  lang === 'en' ? 'Jimmy Chen · Notes on technology & life' : 'Jimmy Chen · 技術與生活隨筆';
const name = lang === 'en' ? 'Jimmy Chen' : '陳建豪';
const slogan = lang === 'en' ? 'Grains of light, gathered into writing' : '微光聚斂處　粒粒皆文章';

const homeBlog = lang === 'en' ? '/en/blog/' : '/blog/';
const recent = (await getPosts(lang)).slice(0, 3);
---

<div class:list={['home', { en: lang === 'en' }]}>
  <article class="essay">
    <p class="sub">{sub}</p>

    {
      lang === 'en' ? (
        <div class="prose">
          <p class="lead">I'm Jimmy Chen — 陳建豪.</p>
          <p>
            By day I'm a DevOps / SRE engineer, working with system architecture and automated
            deployment; lately I've also been pairing with algorithms to find a graceful rhythm
            inside AI agentic workflows. Engineering is the craft of staying steady and precise —
            building a stable little castle out of logic measured in microns.
          </p>
          <p class="quiet">
            When the terminal's chatter settles and the last note of <em>吉</em> (auspice) still
            lingers, the scent of <em>米</em> (rice) simmering at home has already drifted in.
          </p>
          <p>
            Off the clock I like watching a film, reading a few pages, and jotting down the small
            sparks of daily life. This site is a sheet of rice-coloured paper I've spread out in the
            digital world, stamped with a vermilion seal carved with the character 「吉」.
          </p>
          <p class="quiet">
            Not just cold commands and architecture diagrams — this is where I gather my technical
            explorations and the fragments of everyday light, grain by grain, into writing. Welcome;
            feel free to wander.
          </p>
        </div>
      ) : (
        <div class="prose">
          <p class="lead">我是陳建豪，朋友習慣叫我 Jimmy。</p>
          <p>
            日常裡，我是一位與系統架構、自動化部署打交道的 DevOps / SRE 工程師，也在 AI Agentic
            工作流的浪潮中，試著與演算法搭檔出優雅的協作節奏。工程的本質是求穩與求精，像是在極小的微米邏輯之間，築起平穩運作的城堡。
          </p>
          <p class="quiet">
            當終端機的訊號聲沉澱下來，<em>吉</em>音未落之際，屋裡炊煮的<em>米</em>香便已悄然飄至。
          </p>
          <p>
            卸下架構與邏輯之後，我喜歡看一部電影、讀幾頁書、紀錄生活裡的靈光一閃。這個網站是我在數位世界裡鋪開的一方米色宣紙，蓋上一枚刻著「吉」字的朱紅落款。
          </p>
          <p>這裡不只有冰冷的指令與架構圖，更有我將技術探索與生活碎光細細收斂、粒粒成章的軌跡。</p>
          <p class="quiet">微光聚斂處，粒粒皆文章。歡迎來到這裡，隨意走走。</p>
        </div>
      )
    }

    {
      recent.length > 0 && (
        <div class="refs">
          <div class="lbl">{t('home.recent')}</div>
          {recent.map((post) => (
            <a href={`${homeBlog}${slugOf(post)}/`}>
              <span>{post.data.title}</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatYearMonth(post.data.pubDate)}
              </time>
            </a>
          ))}
        </div>
      )
    }

    <div class="find">
      <div class="lbl">{t('home.findMe')}</div>
      <SocialLinks />
    </div>
  </article>

  {/* h-card：代表本人的 microformats2 profile（P2-11，供 webmention/Bridgy Fed 解析）。 */}
  <aside class="scroll h-card">
    {
      /* p-name 掛在這個隱藏連結上：立軸不再顯示姓名，但 mf2 的 h-card 仍必須有 name
        （scripts/validate-microformats.mjs 會擋）。 */
    }
    <a class="u-url p-name" href={new URL('/', Astro.site)} hidden>{name}</a>
    {
      /* acct: 形式的 u-url 決定 fediverse handle 的 local part。
        沒有這行 → @jimmychen.me@jimmychen.me（網域重複）；有這行 → @jimmy@jimmychen.me。
        定了不該改：改掉等於換 handle，既有 mention 與追蹤會斷。 */
    }
    <a class="u-url" href="acct:jimmy@jimmychen.me" hidden>@jimmy@jimmychen.me</a>
    {
      /* u-photo：fediverse／Bluesky 的頭像來源。沒有它時只能退而用 favicon。
        路徑固定，換圖只換 public/avatar.png 的內容。 */
    }
    <img class="u-photo" src="/avatar.png" alt="" width="1" height="1" hidden />
    <div class="slogan">{slogan}</div>
    <div class="stamp"><Seal size={56} /></div>
  </aside>
</div>

<style>
  .home {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: start;
  }

  /* 右立軸（繁中） */
  .scroll {
    writing-mode: vertical-rl;
    text-orientation: upright;
    display: flex;
    align-items: flex-start;
    gap: 26px;
    padding-top: 4px;
    user-select: none;
  }
  .scroll .slogan {
    font-size: var(--text-lede);
    color: var(--color-text-secondary);
    letter-spacing: 0.28em;
    line-height: 1.4;
  }
  .scroll .stamp {
    margin-top: 6px;
  }

  /* 英文:橫排,name block 移到上方,單欄 */
  .home.en {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .home.en .scroll {
    order: -1;
    writing-mode: horizontal-tb;
    text-orientation: mixed;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-top: 0;
  }
  .home.en .scroll .slogan {
    letter-spacing: 0.04em;
  }

  /* 左散文 */
  .essay {
    max-width: 600px;
  }
  .sub {
    font-family: var(--font-ui);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: 26px;
  }
  .prose {
    font-size: var(--text-lede);
    line-height: 2;
  }
  .prose p {
    margin-bottom: 1.15rem;
  }
  .prose .lead {
    color: var(--color-text);
  }
  .prose .quiet {
    color: var(--color-text-secondary);
  }
  /* 漢字沒有斜體：瀏覽器對中文的 italic 是把字形整體剪切傾斜（合成斜體），字面會歪，
     故本來就寫了 font-style: normal。補上的是中文真正的強調傳統 —— **着重號**，
     橫排時點在字下方（clreq §3.2「着重號」）。
     只收在 .prose：本站 zh／en 首頁的 <em> 都是單一漢字（吉／米），而文章正文的斜體
     多是 *Tenet* 這類西文作品名，那些該保持 italic，不能一律換成着重號。 */
  .prose em {
    font-style: normal;
    color: var(--color-seal);
    text-emphasis: filled dot;
    text-emphasis-position: under right;
  }

  .refs {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border-subtle);
  }
  .refs .lbl {
    font-family: var(--font-ui);
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    margin-bottom: 10px;
    letter-spacing: 0.05em;
  }
  .refs a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
    color: var(--color-text);
    padding: 7px 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .refs a:hover {
    color: var(--color-seal);
  }
  .refs time {
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    font-family: var(--font-ui);
    white-space: nowrap;
  }

  .find {
    margin-top: 30px;
    font-family: var(--font-ui);
  }
  .find .lbl {
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    margin-bottom: 10px;
  }

  @media (max-width: 820px) {
    .home {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .scroll {
      writing-mode: horizontal-tb;
      text-orientation: mixed;
      flex-direction: column;
      gap: 10px;
      order: -1;
    }
  }
</style>
