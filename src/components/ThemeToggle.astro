---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button type="button" class="theme-toggle" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
  {/* sun（light 時顯示）＋ moon（dark 時顯示），由 CSS 依 data-theme 切換 */}
  <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--color-seal);
  }

  /* dark 預設顯示 moon，light 顯示 sun */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: block;
  }
  :global(:root[data-theme='light']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='light']) .icon-moon {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((el) => {
    el.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* localStorage 不可用時忽略 */
      }
    });
  });
</script>
