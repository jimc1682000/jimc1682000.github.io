---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pathname = Astro.url.pathname;

// A1 路由：語系切換是「整頁導航」到對應 path（DESIGN §7.5）
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref =
  lang === 'en'
    ? pathname.replace(/^\/en/, '') || '/'
    : '/en' + (pathname === '/' ? '/' : pathname);

const homeHref = lang === 'en' ? '/en/' : '/';
const blogHref = lang === 'en' ? '/en/blog/' : '/blog/';
// 子站自帶導覽與語系，主站僅連進去（DESIGN §7.4）
const resumeHref = '/resume/';
const filmBrainHref = '/film-brain/';
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href={homeHref}>Jimmy Chen</a>

    <nav class="site-nav" aria-label={lang === 'en' ? 'Primary' : '主導覽'}>
      <a href={blogHref}>{t('nav.blog')}</a>
      <a href={resumeHref}>{t('nav.resume')}</a>
      <a href={filmBrainHref}>{t('nav.filmBrain')}</a>
    </nav>

    <div class="header-actions">
      <a class="lang-switch" href={switchHref} hreflang={otherLang === 'en' ? 'en' : 'zh-Hant'}>
        {t('lang.switch')}
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-header-bg);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    min-height: 3.5rem;
  }

  .brand {
    font-weight: 700;
    font-size: var(--font-size-lg);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .site-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--color-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .lang-switch {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-switch:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      padding-block: var(--spacing-xs);
    }
    .brand {
      margin-inline-end: 0;
    }
  }
</style>
