---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import Seal from './Seal.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pathname = Astro.url.pathname;

// A1 路由：語系切換是「整頁導航」到對應 path（DESIGN §7.5）
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref =
  lang === 'en'
    ? pathname.replace(/^\/en/, '') || '/'
    : '/en' + (pathname === '/' ? '/' : pathname);

const homeHref = lang === 'en' ? '/en/' : '/';
const blogHref = lang === 'en' ? '/en/blog/' : '/blog/';
const worksHref = lang === 'en' ? '/en/works/' : '/works/';
// 公開面只放 L0 摘要（完整履歷見 docs/hidden-resume.md）
const resumeHref = lang === 'en' ? '/en/resume/' : '/resume/';
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';

const isBlog = pathname === blogHref || pathname.startsWith(blogHref);
const isWorks = pathname === worksHref || pathname.startsWith(worksHref);
const isResume =
  pathname === '/resume' ||
  pathname.startsWith('/resume/') ||
  pathname === '/en/resume' ||
  pathname.startsWith('/en/resume/');

const brand = lang === 'en' ? 'Jimmy Chen' : '吉光聚斂，米粒成章';
---

<header class="site-header">
  <div class="header-inner container">
    {
      /* aria-label 是必要的，不是多餘：小螢幕的 media query 會把 .brand-text 設為
        display:none，而印章是 aria-hidden，屆時整個連結沒有可讀名稱
        （Lighthouse 用行動裝置模擬，因此四頁都報 link-name 失敗）。 */
    }
    <a class="brand" href={homeHref} aria-label={brand}>
      <Seal size={30} />
      <span class="brand-text">{brand}</span>
    </a>

    <nav class="site-nav" aria-label={lang === 'en' ? 'Primary' : '主導覽'}>
      <a
        href={blogHref}
        class:list={['nav-link', { active: isBlog }]}
        aria-current={isBlog ? 'page' : undefined}>{t('nav.blog')}</a
      >
      <a
        href={resumeHref}
        class:list={['nav-link', { active: isResume }]}
        aria-current={isResume ? 'page' : undefined}>{t('nav.resume')}</a
      >
      <a
        href={worksHref}
        class:list={['nav-link', { active: isWorks }]}
        aria-current={isWorks ? 'page' : undefined}>{t('nav.works')}</a
      >
      <a
        class="nav-link lang-switch"
        href={switchHref}
        hreflang={otherLang === 'en' ? 'en' : 'zh-Hant'}>{t('lang.switch')}</a
      >

      <span class="icons">
        <a
          class="nav-ic"
          href="https://github.com/jimc1682000"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <Icon name="github" size={18} />
        </a>
        <a class="nav-ic" href={rssHref} aria-label="RSS">
          <Icon name="rss" size={18} />
        </a>
        <ThemeToggle lang={lang} />
      </span>
    </nav>
  </div>
</header>

<style>
  /* antfu 式透明:無底色、無 border、absolute 貼頁頂 */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding-top: 22px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700; /* subset 只有 400／700，宣告 600 也是落到 700 */
    font-size: var(--text-body);
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    font-family: var(--font-ui);
  }

  .nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-label);
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link.active {
    color: var(--color-text);
    border-bottom: 2px solid var(--color-seal);
    padding-bottom: 2px;
  }

  .icons {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-left: 4px;
  }

  .nav-ic {
    display: inline-flex;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-ic:hover {
    color: var(--color-seal);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--spacing-sm);
    }
    .brand-text {
      display: none;
    }
    .site-nav {
      gap: 14px;
    }
  }
</style>
