---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getTags, getPostsByTag } from '../../../lib/blog';
import { useTranslations } from '../../../i18n/ui';

const lang = 'zh' as const;

export const getStaticPaths = (async () => {
  const tags = await getTags('zh');
  const paths = [];
  for (const tag of tags) {
    paths.push({ params: { tag }, props: { tag, posts: await getPostsByTag('zh', tag) } });
  }
  return paths;
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={`${t('blog.taggedWith')}：${tag} — 陳建豪 Jimmy Chen`} description={`標籤「${tag}」的文章。`} lang={lang}>
  <div class="container-narrow tag-page">
    <header class="tag-header">
      <p class="crumb"><a href="/blog/tags/">{t('blog.allTags')}</a></p>
      <h1>#{tag}</h1>
      <p class="count">{posts.length} {t('blog.postCount')}</p>
    </header>
    <PostList posts={posts} lang={lang} />
  </div>
</BaseLayout>

<style>
  .tag-page {
    padding-block: var(--spacing-2xl);
  }
  .tag-header {
    margin-bottom: var(--spacing-xl);
  }
  .crumb {
    font-size: var(--font-size-sm);
    margin-bottom: var(--spacing-xs);
  }
  .crumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--color-text);
  }
  .tag-header h1 {
    font-size: var(--font-size-4xl);
  }
  .count {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-xs);
  }
</style>
