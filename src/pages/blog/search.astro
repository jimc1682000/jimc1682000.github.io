---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'zh' as const;
const t = useTranslations(lang);

// Pagefind UI 譯文（DESIGN §7.5 語系 UI）。
const pf = {
  placeholder: t('search.placeholder'),
  clear_search: t('search.clear'),
  zero_results: t('search.zeroResults'),
};
---

<BaseLayout
  title={`${t('search.title')} — 陳建豪 Jimmy Chen`}
  description={t('search.description')}
  lang={lang}
>
  {/* Pagefind 自架靜態資源(/pagefind/ 於本站 dist,postbuild 產生),非外部 CDN */}
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <div class="search-page">
    <h1 class="page-h">{t('search.title')}</h1>
    <div id="search"></div>
  </div>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline define:vars={{ pf }}>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: pf,
      });
    });
  </script>
</BaseLayout>

<style>
  .search-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 28px var(--spacing-2xl);
  }

  .page-h {
    font-size: var(--text-page-h);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: var(--spacing-xl);
  }

  /* 用站台 token 覆寫 Pagefind UI 預設色(深淺雙模皆貼近站台) */
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-seal);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg-elevated);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-bg-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-sm);
    --pagefind-ui-font: var(--font-ui);
  }
</style>
