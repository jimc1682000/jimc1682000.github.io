---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostListGrouped from '../../../components/PostListGrouped.astro';
import { getPosts } from '../../../lib/blog';
import { useTranslations } from '../../../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<BaseLayout
  title={`${t('blog.title')} — Jimmy Chen`}
  description="Writing by Jimmy Chen: engineering practice, DevOps / SRE, and AI workflows."
  lang={lang}
>
  <div class="list-page">
    <div class="top-row">
      <h1 class="page-h">{t('blog.title')}</h1>
      <div class="tools">
        <a href="/en/blog/search/">⌕ {t('search.title')}</a>
        <a href="/en/blog/tags/"># {t('blog.tags')}</a>
        <a href="/en/rss.xml">✦ RSS</a>
      </div>
    </div>
    <p class="page-sub">{t('blog.subtitle')}</p>
    <PostListGrouped posts={posts} lang={lang} />
  </div>
</BaseLayout>

<style>
  .list-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 28px var(--spacing-2xl);
  }
  .top-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .page-h {
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .tools {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .tools a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .tools a:hover {
    color: var(--color-seal);
  }
  .page-sub {
    color: var(--color-text-secondary);
    margin-top: 10px;
    font-size: 1.05rem;
  }
</style>
