---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
import { htmlLang, useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 文章頁透傳給 BaseHead：決定 og:type=article 與 BlogPosting 結構化資料 */
  pubDate?: Date;
  tags?: string[];
}

const { title, description, lang, pubDate, tags } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <BaseHead
      title={title}
      description={description}
      lang={lang}
      pubDate={pubDate}
      tags={tags}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
