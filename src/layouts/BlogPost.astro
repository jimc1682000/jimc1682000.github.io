---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { formatDate } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pubDate: Date;
  tags: string[];
}

const { title, description, lang, pubDate, tags } = Astro.props;
const t = useTranslations(lang);
const tagsBase = lang === 'en' ? '/en/blog/tags' : '/blog/tags';
const blogHref = lang === 'en' ? '/en/blog/' : '/blog/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="post container-narrow">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>
          {t('blog.publishedOn')} {formatDate(pubDate, lang)}
        </time>
      </p>
      {
        tags.length > 0 && (
          <ul class="post-tags" aria-label={t('blog.tags')}>
            {tags.map((tag) => (
              <li>
                <a class="tag-chip" href={`${tagsBase}/${tag}/`}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="post-body">
      <slot />
    </div>

    <footer class="post-footer">
      <a href={blogHref}>← {t('blog.backToList')}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--spacing-2xl);
  }

  .post-header {
    margin-bottom: var(--spacing-xl);
  }

  .post-header h1 {
    font-size: var(--font-size-4xl);
    margin-bottom: var(--spacing-sm);
  }

  .post-meta {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-sm);
  }

  .post-tags {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  /* 正文：窄欄、18px、行高 1.7（DESIGN §4） */
  .post-body {
    font-size: var(--font-size-lg);
    line-height: 1.7;
  }

  .post-body :global(h2) {
    font-size: var(--font-size-2xl);
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-sm);
  }

  .post-body :global(h3) {
    font-size: var(--font-size-xl);
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-xs);
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol),
  .post-body :global(pre),
  .post-body :global(blockquote) {
    margin-bottom: var(--spacing-md);
  }

  .post-body :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--spacing-md);
  }

  .post-footer {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--font-size-sm);
  }

  .post-footer a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .post-footer a:hover {
    color: var(--color-text);
  }
</style>
