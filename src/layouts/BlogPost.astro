---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { formatDate } from '../lib/blog';
import Seal from '../components/Seal.astro';
import DiscussionTabs from '../components/DiscussionTabs.astro';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pubDate: Date;
  tags: string[];
  aiTranslated?: boolean;
  translationOf?: string;
}

const { title, description, lang, pubDate, tags, aiTranslated, translationOf } = Astro.props;
const t = useTranslations(lang);
const blogHref = lang === 'en' ? '/en/blog/' : '/blog/';
// AI 翻譯提示：僅英文版且標記 aiTranslated 時顯示；連回中文原文 /blog/<translationOf>。
const showAiNotice = lang === 'en' && aiTranslated;
const originalHref = translationOf ? `/blog/${translationOf}/` : '/blog/';
const signoffYear = pubDate.getFullYear();
// microformats2（P2-11）：h-entry 的 u-url 與 p-author h-card 需絕對 URL。
const postURL = new URL(Astro.url.pathname, Astro.site);
const authorName = lang === 'en' ? 'Jimmy Chen' : '陳建豪';
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  pubDate={pubDate}
  tags={tags}
>
  <article class="post h-entry" data-pagefind-body>
    <a class="crumb" href={blogHref}>← {t('blog.backToList')}</a>
    <h1 class="p-name">{title}</h1>
    <div class="metar">
      <time class="dt-published" datetime={pubDate.toISOString()}>
        {t('blog.publishedOn')} {formatDate(pubDate, lang)}
      </time>
      {tags.map((tag) => <span class="ptag p-category">{tag}</span>)}
    </div>

    {/* Bridgy Fed 即時聯邦（P2-13）：有這個連結時，我們的 webmention 發送器會在部署後
        通知 fed.brid.gy，新文章立刻聯邦到 fediverse／Bluesky，不必等它輪詢 RSS。
        **只在繁中版輸出**：中文版是內容的真相源；英文版也放的話同一篇會聯邦兩次，
        對追蹤者是噪音。
        ⚠️ 取捨：Bridgy Fed 文件明載「送過一次 webmention 後，它會停止讀你的 Atom/RSS
        feed，改為期待所有未來貼文都用 webmention」。也就是說發送器若壞掉，新文章會
        安靜地不再聯邦。要退回輪詢模式就移除本行（並留意該切換可能不會立即回復）。
        註：Bridgy Fed 文件範例寫 hidden="from-humans"，但 hidden 是列舉屬性
        （""/hidden/until-found），該值不合法（html-validate 會抓）。Bridgy Fed 只認
        class 與 href，故用純 hidden。 */}
    {lang !== 'en' && (
      <a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden aria-hidden="true" />
    )}

    {/* mf2 的 u-url / p-author：解析器需要但版面不需要，故隱藏（DOM 中仍可解析）。 */}
    <a class="u-url" href={postURL} hidden>{title}</a>
    <a class="p-author h-card" href={new URL('/', Astro.site)} rel="author" hidden>{authorName}</a>

    {
      showAiNotice && (
        <aside class="ai-notice">
          <span class="ai-ico">✦</span>
          <span>
            {t('post.aiTranslatedNotice')}{' '}
            <a href={originalHref}>{t('post.readOriginal')} →</a>
          </span>
        </aside>
      )
    }

    <div class="body e-content">
      <slot />
    </div>

    <div class="signoff">
      <Seal size={52} />
      <span>{t('post.signoff')} · {signoffYear}</span>
    </div>

    <DiscussionTabs target={postURL} lang={lang} />
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 28px var(--spacing-lg);
  }

  .crumb {
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .crumb:hover {
    color: var(--color-seal);
  }

  .post h1 {
    font-size: var(--text-post-h);
    line-height: 1.3;
    font-weight: 700;
    margin: 14px 0 12px;
  }

  .metar {
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    color: var(--color-text-tertiary);
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }
  .metar .ptag {
    color: var(--color-seal);
    background: var(--color-seal-tint);
    padding: 0.1rem 0.5rem;
    border-radius: 100px;
    font-size: var(--text-tag);
  }

  .ai-notice {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 20px;
    padding: 12px 16px;
    background: var(--color-seal-tint);
    border-left: 3px solid var(--color-seal);
    border-radius: var(--radius-sm);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .ai-notice .ai-ico {
    color: var(--color-seal);
    flex: none;
  }
  .ai-notice a {
    color: var(--color-seal);
    text-decoration: none;
    white-space: nowrap;
  }
  .ai-notice a:hover {
    text-decoration: underline;
  }

  /* 正文用系統黑體：宋體在各系統上都不可靠 —— macOS 只有 Songti、Windows 只有新細明體、
     Android 通常沒有 serif，而 Songti 的粗體天生輕，行內強調看不出來。身分識別交給
     標題的思源黑體、朱砂與落款印章。參數是為黑體重調的，不能沿用宋體那套：黑體筆畫
     均勻、同字級視覺重量更大（字級 1.02rem、行高 2.1、字距 +0.015em、首行縮排 2em）。 */
  .body {
    margin-top: 32px;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 2.1;
    letter-spacing: 0.015em;
    /* 黑體比宋體搶眼，把文字收一點回到「墨」。
       用 color-mix 而不是 opacity：`opacity` 會 composite 整個 .e-content 子樹，
       圖片、figure、code 區塊會一起被淡掉 6% —— 那是改動媒體外觀，不是「軟化文字」。
       兩個都是 token（亮暗模式的墨與紙不同），對純色底而言 94% 混色與 opacity .94
       的文字結果等價。連結與引文有自己的顏色規則，不受這行影響。 */
    color: color-mix(in srgb, var(--color-text) 94%, var(--color-bg));
  }
  /* 首行縮排是中文散文慣例，也是換掉宋體之後把「文氣」找回來的關鍵；
     段距因此收小，靠縮排而非空白分段。引文與清單不套（縮排會打亂它們的層次）。 */
  /* 只套**直接子層**的段落。用後代選擇器會連 blockquote 與 loose list 裡的 <p> 一起縮排
     （markdown 的引文渲染成 `<blockquote><p>…`），把引文的對齊推歪 —— 與上面註解說的
     「引文與清單不套」相反。 */
  .body > :global(p) {
    text-indent: 2em;
    margin: 0 0 0.5rem;
  }
  .body :global(h2) {
    font-size: var(--text-subhead);
    margin: 2.2rem 0 1rem;
    padding-left: 14px;
    border-left: 4px solid var(--color-seal);
  }
  .body :global(h3) {
    font-size: var(--text-title);
    margin: 1.6rem 0 0.8rem;
  }
  /* 正文連結：朱砂虛點底線。用 text-decoration 而非 border-bottom，
     斷行時底線會跟著字走、不會拉出整行的框線 */
  .body :global(a) {
    color: var(--color-text);
    text-decoration: underline dotted var(--color-seal);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1.5px;
  }
  /* 明確宣告 hover，否則會吃到 global.css 的 a:hover
     （那條把底線轉成 --color-text，會蓋掉朱砂） */
  .body :global(a:hover) {
    color: var(--color-seal);
    text-decoration-color: var(--color-seal);
  }
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1.3rem;
  }
  .body :global(li) {
    margin-bottom: 0.4rem;
  }
  .body :global(blockquote) {
    margin: 1.4rem 0;
    padding: 2px 0 2px 18px;
    border-left: 3px solid var(--color-seal);
    color: var(--color-text-secondary);
  }
  .body :global(pre) {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: 10px;
    padding: 16px 18px;
    overflow: auto;
    margin: 1.4rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.7;
    color: var(--color-text);
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--color-bg-surface);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
  .body :global(pre code) {
    background: none;
    padding: 0;
  }
  .body :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--spacing-md);
  }
  /* 圖說：用 <figure>／<figcaption> 標語意，樣式沿用 .signoff 那套次要小字 */
  .body :global(figure) {
    margin-block: var(--spacing-md);
  }
  /* figure 自己已有 margin，圖片不再重複撐開，圖說才貼得住圖 */
  .body :global(figure img) {
    margin-block: 0;
  }
  .body :global(figcaption) {
    margin-top: var(--spacing-xs);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    color: var(--color-text-tertiary);
    text-align: center;
  }

  .signoff {
    margin: 44px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text-tertiary);
    font-size: var(--text-label);
    font-family: var(--font-ui);
  }

</style>
